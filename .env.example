# Bot Lite Downloader — environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Required ─────────────────────────────────────────────────────────────────
# Telegram API credentials — https://my.telegram.org → API development tools
API_ID=0
API_HASH=

# Bot token from @BotFather
BOT_TOKEN=

# ── Admin users ──────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs (find yours via @userinfobot)
SUDO_USERS=

# ── Optional tuning ──────────────────────────────────────────────────────────
# Maximum file size in bytes (default: 2 GB — Telegram hard limit)
# MAX_FILE_SIZE=2147483648

# Maximum simultaneous downloads across all users
# MAX_CONCURRENT_DOWNLOADS=3

# Minimum free disk space before rejecting downloads (default: 500 MB)
# MIN_FREE_DISK=524288000

# Per-user cooldown between requests in seconds (0 = disabled)
# USER_COOLDOWN=5

# SQLite database path
# DB_FILE=media_bot.db
